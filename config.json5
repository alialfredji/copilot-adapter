// Configuration for copilot-sdk-proxy.
// Edit this file to add MCP servers, control tool access, and set permissions.

{
  // Per-provider MCP servers. Example:
  // openai: {
  //   mcpServers: {
  //     filesystem: {
  //       type: "local",
  //       command: "npx",
  //       args: ["-y", "@modelcontextprotocol/server-filesystem", "/Users/me/projects"],
  //     },
  //   },
  // },
  // Per-provider MCP servers. Reasoning effort is intentionally omitted so
  // the selected model can use its own supported default.
  claude: { mcpServers: {} },
  codex: { mcpServers: {} },
  openai: { mcpServers: {} },

  // The CLI --policy flag supplies the built-in tool allowlist. This remains
  // empty so direct library use is safe by default.
  allowedCliTools: [],

  // Auto-approve permission requests. Set to true to approve all, false to deny
  // all, or pass an array of specific kinds:
  // ["read", "write", "shell", "mcp", "url", "custom-tool", "memory", "hook"].
  autoApprovePermissions: false,

  // Maximum request body size in MiB.
  bodyLimit: 10,

  // Server-level request timeout in minutes. 0: disabled.
  requestTimeout: 0,
}
