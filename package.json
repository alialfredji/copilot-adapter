{
  "name": "copilot-harness-adapter",
  "version": "0.1.0",
  "description": "Secure local GitHub Copilot adapter for Codex and Claude Code",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "copilot",
    "github-copilot",
    "proxy",
    "openai",
    "anthropic",
    "claude",
    "codex"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "copilot-harness": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "imports": {
    "#*": {
      "copilot-sdk-proxy-dev": "./src/*",
      "default": "./dist/*"
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "config.json5"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx -C copilot-sdk-proxy-dev src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "fmt": "oxfmt --write src/ test/",
    "fmt:check": "oxfmt --check src/ test/",
    "lint": "oxlint src/ test/",
    "typecheck": "tsc -p tsconfig.check.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@github/copilot-sdk": "1.0.8",
    "commander": "15.0.0",
    "fastify": "5.12.1",
    "json5": "2.2.3",
    "jsonc-parser": "3.3.1",
    "llm-schemas": "1.1.0",
    "picocolors": "1.1.1",
    "tokenx": "1.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "llm-mock-server": "1.1.0",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
